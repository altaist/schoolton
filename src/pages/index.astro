---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Schoolton">
	<main>
		<style>
			body {
				background-color: #212529 !important;
				min-height: 100vh;
				margin: 0;
				padding: 0;
			}
			main {
				min-height: 100vh;
				background-color: #212529;
			}
			:global(body) {
				background-color: #212529 !important;
			}
			:global(html) {
				background-color: #212529 !important;
			}
		</style>
		<slot />
	</main>
</Layout> 